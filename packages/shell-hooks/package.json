{
  "name": "@-label-/shell-hooks",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@-label-/shell-core": "workspace:*",
    "zustand": "5.0.12",
    "react": "19.2.4",
    "react-router": "7.13.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-router": ">=7"
  },
  "devDependencies": {
    "@-label-/contracts": "workspace:*",
    "@-label-/lint-config": "2.3.2",
    "@types/react": "19.2.14",
    "eslint": "9.39.2",
    "oxlint": "1.56.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "echo \"test — n/a\"",
    "test:ci": "echo \"test:ci — n/a\"",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run '/^(eslint|oxlint)$/'",
    "eslint:base": "eslint --cache --no-warn-ignored --max-warnings 0",
    "eslint": "pnpm run eslint:base src",
    "eslint:staged": "pnpm run eslint:base",
    "oxlint:base": "oxlint --config .oxlintrc.json",
    "oxlint": "pnpm run oxlint:base src",
    "oxlint:staged": "pnpm run oxlint:base",
    "prettier:check": "prettier --check",
    "prettier:write": "prettier --write --cache ."
  }
}
