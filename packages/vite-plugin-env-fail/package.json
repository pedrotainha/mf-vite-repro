{
  "name": "@-label-/vite-plugin-env-fail",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "vite": "8.0.1"
  },
  "devDependencies": {
    "@-label-/lint-config": "2.3.2",
    "eslint": "9.39.2",
    "oxlint": "1.56.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "echo \"test — n/a\"",
    "test:ci": "echo \"test:ci — n/a\"",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run '/^(eslint|oxlint)$/'",
    "eslint:base": "eslint --cache --no-warn-ignored --max-warnings 0",
    "eslint": "pnpm run eslint:base src",
    "eslint:staged": "pnpm run eslint:base",
    "oxlint:base": "oxlint --config .oxlintrc.json",
    "oxlint": "pnpm run oxlint:base src",
    "oxlint:staged": "pnpm run oxlint:base",
    "prettier:check": "prettier --check",
    "prettier:write": "prettier --write --cache ."
  }
}
