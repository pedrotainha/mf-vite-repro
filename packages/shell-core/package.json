{
  "name": "@-label-/shell-core",
  "version": "0.2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "dependencies": {
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@-label-/contracts": "workspace:*",
    "@-label-/lint-config": "2.3.2",
    "eslint": "9.39.2",
    "oxlint": "1.56.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "echo \"build — source-only package, consumed via pnpm workspaces\"",
    "test": "echo \"test — n/a\"",
    "test:ci": "echo \"test:ci — n/a\"",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run '/^(eslint|oxlint)$/'",
    "eslint:base": "eslint --cache --no-warn-ignored --max-warnings 0",
    "eslint": "pnpm run eslint:base src",
    "eslint:staged": "pnpm run eslint:base",
    "oxlint:base": "oxlint --config .oxlintrc.json",
    "oxlint": "pnpm run oxlint:base src",
    "oxlint:staged": "pnpm run oxlint:base",
    "prettier:check": "prettier --check",
    "prettier:write": "prettier --write --cache ."
  }
}
