{
  "name": "poc-mfe-csr-mf",
  "version": "0.0.1",
  "private": true,
  "description": "POC Micro-Frontend CSR with @module-federation/vite",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm",
    "build:fleet": "pnpm --filter @-label-/fleet build",
    "build:rentals": "pnpm --filter @-label-/rentals build",
    "build:maintenance": "pnpm --filter @-label-/maintenance build",
    "build:host": "pnpm --filter @-label-/host build",
    "build:packages": "pnpm --filter './packages/*' --filter './clients/*' run build",
    "build:remotes": "pnpm run build:fleet && pnpm run build:rentals && pnpm run build:maintenance",
    "build:all": "pnpm run build:packages && pnpm run build:remotes && pnpm run build:host",
    "preview:fleet": "pnpm --filter @-label-/fleet preview",
    "preview:rentals": "pnpm --filter @-label-/rentals preview",
    "preview:maintenance": "pnpm --filter @-label-/maintenance preview",
    "preview:host": "pnpm --filter @-label-/host preview",
    "dev": "pnpm -r --parallel run dev",
    "dev:host": "pnpm --filter @-label-/host dev",
    "dev:remotes": "pnpm --filter @-label-/fleet --filter @-label-/rentals --filter @-label-/maintenance --parallel run dev",
    "preview:remotes": "pnpm --filter @-label-/fleet --filter @-label-/rentals --filter @-label-/maintenance --parallel run preview",
    "preview:all": "pnpm -r --parallel run preview",
    "serve": "pnpm run build:all && pnpm run preview:all",
    "build": "echo \"build — n/a para root, usar build:all\"",
    "test": "echo \"test — n/a para este repo\"",
    "test:ci": "echo \"test:ci — n/a para este repo\"",
    "test:all": "pnpm -r --include-workspace-root run test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:smoke:dev-dev": "E2E_HOST_URL=http://localhost:4173 E2E_FLEET_ENTRY=http://localhost:4174/remoteEntry.js E2E_RENTALS_ENTRY=http://localhost:4175/remoteEntry.js E2E_MAINTENANCE_ENTRY=http://localhost:4176/remoteEntry.js pnpm run test:e2e:smoke",
    "test:e2e:smoke:dev-preview": "E2E_HOST_URL=http://localhost:4173 E2E_FLEET_ENTRY=http://localhost:5174/remoteEntry.js E2E_RENTALS_ENTRY=http://localhost:5175/remoteEntry.js E2E_MAINTENANCE_ENTRY=http://localhost:5176/remoteEntry.js pnpm run test:e2e:smoke",
    "test:e2e:smoke:preview-preview": "E2E_HOST_URL=http://localhost:5173 E2E_FLEET_ENTRY=http://localhost:5174/remoteEntry.js E2E_RENTALS_ENTRY=http://localhost:5175/remoteEntry.js E2E_MAINTENANCE_ENTRY=http://localhost:5176/remoteEntry.js pnpm run test:e2e:smoke",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:all": "pnpm -r --include-workspace-root run typecheck",
    "lint": "pnpm run '/^(eslint|oxlint)$/'",
    "lint:all": "pnpm -r --include-workspace-root run lint",
    "eslint:base": "eslint --cache --no-warn-ignored --max-warnings 0",
    "eslint": "pnpm run eslint:base .",
    "eslint:staged": "pnpm run eslint:base",
    "oxlint:base": "oxlint --config .oxlintrc.json",
    "oxlint": "pnpm run oxlint:base .",
    "oxlint:staged": "pnpm run oxlint:base",
    "prettier:check": "prettier --check",
    "prettier:write": "prettier --write --cache .",
    "prettier:all": "pnpm -r --include-workspace-root run prettier:check .",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "publish:packages": "changeset-publish-fix",
    "generate:clients": "echo 'TODO: orval generate'"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commit-lint $1"
  },
  "devDependencies": {
    "@-label-/api-codegen": "2.0.0",
    "@-label-/changeset-publish-fix": "0.1.11",
    "@-label-/commit-lint": "0.3.3",
    "@-label-/lint-config": "2.3.2",
    "@axe-core/playwright": "4.11.1",
    "@changesets/cli": "2.30.0",
    "@playwright/test": "1.58.2",
    "eslint": "9.39.4",
    "lint-staged": "16.4.0",
    "oxlint": "1.56.0",
    "prettier": "3.8.1",
    "simple-git-hooks": "2.13.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@-label-/changeset-publish-fix",
      "@-label-/commit-lint",
      "@-label-/lint-config",
      "esbuild",
      "simple-git-hooks"
    ],
    "patchedDependencies": {
      "@module-federation/vite@1.13.1": "patches/@module-federation__vite@1.13.1.patch"
    },
    "overrides": {
      "flatted": "3.4.2"
    }
  }
}
