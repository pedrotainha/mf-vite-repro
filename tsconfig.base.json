{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": false,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@-label-/contracts": ["./packages/contracts/src/index.ts"],
      "@-label-/federation-config": ["./packages/federation-config/src/index.ts"],
      "@-label-/utils": ["./packages/utils/src/index.ts"],
      "@-label-/mfe-loader": ["./packages/mfe-loader/src/index.ts"],
      "@-label-/shell-core": ["./packages/shell-core/src/index.ts"],
      "@-label-/shell-hooks": ["./packages/shell-hooks/src/index.ts"],
      "@-label-/vite-plugin-config-chunk": ["./packages/vite-plugin-config-chunk/src/index.ts"],
      "@-label-/vite-plugin-env-fail": ["./packages/vite-plugin-env-fail/src/index.ts"],
      "@-label-/vite-plugin-mfe-config-api": ["./packages/vite-plugin-mfe-config-api/src/index.ts"],
      "@-label-/client-fleet": ["./clients/client-fleet/src/index.ts"],
      "@-label-/client-fleet/mocks": ["./clients/client-fleet/src/mocks/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
