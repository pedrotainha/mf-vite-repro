{
  "name": "@-label-/host",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "echo \"test — n/a\"",
    "test:ci": "echo \"test:ci — n/a\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run '/^(eslint|oxlint)$/'",
    "eslint:base": "eslint --cache --no-warn-ignored --max-warnings 0",
    "eslint": "pnpm run eslint:base src",
    "eslint:staged": "pnpm run eslint:base",
    "oxlint:base": "oxlint --config .oxlintrc.json",
    "oxlint": "pnpm run oxlint:base src",
    "oxlint:staged": "pnpm run oxlint:base",
    "prettier:check": "prettier --check",
    "prettier:write": "prettier --write --cache ."
  },
  "dependencies": {
    "@-label-/contracts": "workspace:*",
    "@-label-/mfe-loader": "workspace:*",
    "@-label-/shell-core": "workspace:*",
    "@-label-/shell-hooks": "workspace:*",
    "@-label-/ui-internal-core": "0.3.33",
    "@module-federation/runtime": "2.2.3",
    "@tanstack/react-query": "5.91.2",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@-label-/federation-config": "workspace:*",
    "@-label-/lint-config": "latest",
    "@-label-/vite-plugin-mfe-config-api": "workspace:*",
    "@axe-core/playwright": "^4.11.1",
    "@module-federation/vite": "1.13.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.2",
    "oxlint": "1.56.0",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "8.0.1"
  }
}
